{
  "info": {
    "name": "Leite Solidário — CP2",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Executar na ordem. Cria dados fictícios e exclui apenas os IDs criados no fluxo."
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:9000"
    },
    {
      "key": "doadoraId",
      "value": ""
    },
    {
      "key": "doacaoId",
      "value": ""
    },
    {
      "key": "emailTeste",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "01 Saúde",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/actuator/health",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "actuator",
            "health"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });"
            ]
          }
        }
      ]
    },
    {
      "name": "02 Cadastrar doadora",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/v1/doadoras",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "doadoras"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nome\": \"Ana Silva\",\n  \"email\": \"{{emailTeste}}\",\n  \"telefone\": \"11999999999\",\n  \"cidade\": \"São Paulo\",\n  \"ativa\": true\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.collectionVariables.set(\"emailTeste\", \"teste-\" + pm.variables.replaceIn(\"{{$guid}}\") + \"@example.com\");"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 201\", function () { pm.response.to.have.status(201); });",
              "if (pm.response.code === 201) pm.collectionVariables.set(\"doadoraId\", pm.response.json().id);"
            ]
          }
        }
      ]
    },
    {
      "name": "03 Listar doadoras",
